# AICluster Backend Configuration
# Copy this file to .env and modify as needed.

# Security
# Set a specific JWT secret key. If not set, a random key is generated on first run
# and stored in data/secret.key.
# AICLUSTER_SECRET_KEY=

# Set a specific admin password for first-run seeding.
# If not set, a random password is generated and printed to stderr.
# AICLUSTER_ADMIN_PASSWORD=

# Database
# DATABASE_URL=sqlite+aiosqlite:///./data/aicluster.db

# Server
# HOST=0.0.0.0
# PORT=8000

# Auth
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logging
# LOG_LEVEL=INFO
