{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AICluster Studio",
  "version": "2.0.0",
  "identifier": "com.aicluster.studio",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AICluster Studio",
        "label": "main",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "visible": true,
        "focus": true,
        "shadow": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": true,
      "tooltip": "AICluster Studio"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 AICluster",
    "shortDescription": "AICluster Studio - Native Desktop Application",
    "longDescription": "AICluster Studio is the native desktop application for the AICluster platform. It manages the entire application lifecycle — starting, monitoring, and recovering all backend services automatically."
  }
}
