{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AICluster Studio",
  "version": "1.2.1",
  "identifier": "com.aicluster.studio",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AICluster Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 AICluster",
    "shortDescription": "AICluster Studio - Visual IDE & Workspace",
    "longDescription": "AICluster Studio - Visual IDE & Workspace"
  }
}
